# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Qdrant (leave blank to use local qdrant_storage/) ─────────────────────────
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── Ollama embeddings (must be running on this server) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Google Sheets logging (leave blank to disable) ────────────────────────────
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_ID=

# ── App ───────────────────────────────────────────────────────────────────────
CMED_PORT=7860
CORS_ORIGINS=*
