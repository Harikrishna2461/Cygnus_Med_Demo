[Unit]
Description=CHIVA Clinical Assistant
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/chiva/backend
EnvironmentFile=/var/www/chiva/backend/.env
ExecStart=/var/www/chiva/backend/venv/bin/gunicorn -c /var/www/chiva/backend/gunicorn.conf.py wsgi:app
Restart=always
RestartSec=5
StandardOutput=append:/var/log/chiva/chiva.log
StandardError=append:/var/log/chiva/chiva-error.log

[Install]
WantedBy=multi-user.target
