[Unit]
Description=Shunt Classification and Ligation Assistant
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/var/www/Cygnus_Med_Demo/Task_1_App/backend
EnvironmentFile=/var/www/Cygnus_Med_Demo/Task_1_App/backend/.env
ExecStartPre=/bin/bash -c 'cd /var/www/Cygnus_Med_Demo && git pull origin main && Task_1_App/backend/venv/bin/pip install -r Task_1_App/backend/requirements.txt -q'
ExecStart=/var/www/Cygnus_Med_Demo/Task_1_App/backend/venv/bin/gunicorn -c /var/www/Cygnus_Med_Demo/Task_1_App/backend/gunicorn.conf.py wsgi:app
Restart=always
RestartSec=5
StandardOutput=append:/var/log/shunt_classification_and_ligation/app.log
StandardError=append:/var/log/shunt_classification_and_ligation/app-error.log

[Install]
WantedBy=multi-user.target