                <mxCell id="rg1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#0e6b5c;strokeWidth=2;fontSize=17;" value="&lt;b&gt;rag_engine.py&lt;/b&gt;&lt;br&gt;vector search + BM25 merge + cross-encoder rerank&lt;br&gt;collection: ligation_knowledgebase_db_v2" vertex="1">
