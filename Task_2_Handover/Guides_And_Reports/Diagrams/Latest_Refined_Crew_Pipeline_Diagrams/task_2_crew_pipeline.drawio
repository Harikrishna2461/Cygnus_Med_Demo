        <mxCell id="T3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;fontColor=default;fontSize=11;" value="&lt;b&gt;Task 3 — Circuit Analyst&lt;/b&gt;&lt;br&gt;agent: make_circuit_analyst()&lt;br&gt;model: GROQ_TEXT_MODEL&lt;br&gt;context: Task 1 + Task 2 outputs&lt;br&gt;&lt;br&gt;out: ≤80 words — state A–F and&lt;br&gt;examine here / route to zone" vertex="1">
