                <!-- TIER 5 — Crew Pipeline -->
                <mxCell id="crew" value="&lt;b&gt;crew_pipeline.run_guidance_crew()&lt;/b&gt; — Crew(process=Process.sequential) — timeout 90 s&#xa;&#xa;Task 1: Clinical Interpreter [MID]  →  Task 2: Shunt Analyst [HEAVY] → JSON {shunt_type, confirmed, elim_required, evidence}&#xa;→  Task 3: Circuit Analyst [HEAVY]  →  Task 4: Navigation Planner [MID]  →  Task 5: Guidance Specialist [HEAVY] → JSON {guidance, action}&#xa;&#xa;crew_agents.py: _patched_completion() strips cache_breakpoint from all litellm calls&#xa;All agents: max_iter=3 · verbose=True · allow_delegation=False · temperature=0.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3e0;strokeColor=#c88a28;fontColor=#1f3864;fontSize=11;fontStyle=0;" vertex="1" parent="1">
