                <!-- NOTE box -->
                <mxCell id="note" value="NOTE: probe_localizer.py (classify_single) is used only by /api/localize REST endpoint. The streaming path gets its region string from the browser JavaScript mapReg() function — the two implementations are independent. Zone bands (posY boundaries) are defined separately in history_agent.py (_BANDS), crew_pipeline.py (_zone_name()), and q_state_agent.py (_level()) — no shared source of truth." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#c88a28;fontColor=#1f3864;fontSize=10;fontStyle=2;" vertex="1" parent="1">
