# Copy to .env and edit. Paths are on the HOST (Docker Desktop on Windows accepts C:/... style).

# Folder containing the two Qwen GGUF files
QWEN_MODEL_DIR=D:/models/Qwen3.8-27B-GGUF
QWEN_GGUF_FILE=Qwen3.8-27B-UD-Q4_K_M.gguf
QWEN_MMPROJ_FILE=mmproj-F16.gguf

# Folder with fascia/model_state_dict.pt and vein/model_state_dict.pt (the two finetuned BioMedParse checkpoints)
BIOMEDPARSE_WEIGHTS_DIR=D:/biomedparse_weights

# Decode slots on the Qwen server == max concurrent VLM calls from the app. Each slot gets
# QWEN_CTX_SIZE / VLM_MAX_CONCURRENT tokens of context (default 65536 / 2 = 32768 per call).
VLM_MAX_CONCURRENT=2
QWEN_CTX_SIZE=65536

APP_PORT=7862
